  }
  .chart-note { font-size: 0.8rem; color: var(--muted); margin-top: 6px; }
  table {
    width: 100%; border-collapse: collapse; font-size: 0.86rem;
  }
  th, td {
    border: 1px solid var(--border); padding: 7px 9px; text-align: right;
  }
  th {
    background: var(--navy); color: #fff; font-weight: 600; text-align: center;
  }
  td.left { text-align: left; }
  td.center { text-align: center; }
  tr:nth-child(even) td { background: #f8fafc; }
  td input, td select {
    width: 90px; padding: 4px 6px; text-align: right;
