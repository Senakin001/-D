function getParams() {
  const A = parseFloat(document.getElementById('inp_A').value) || 0.00049;
  const d = parseFloat(document.getElementById('inp_d').value) || 0.0002;
  const eps0 = parseFloat(document.getElementById('inp_eps0').value) || 8.854e-12;
  const n = parseFloat(document.getElementById('inp_n').value) || 1.45;
  const mu = parseFloat(document.getElementById('inp_mu').value) || 6.34e-30;
  const rho = parseFloat(document.getElementById('inp_rho').value) || 1180;
  const M0 = parseFloat(document.getElementById('inp_M0').value) || 0.08609;
  const k = parseFloat(document.getElementById('inp_k').value) || 1.380e-23;
  const NA = 6.022e23;
  const R_gas = 8.314;
  const C0 = eps0 * A / d;
  const N = (rho / M0) * NA;
  return { A, d, eps0, n, mu, rho, M0, k, NA, R_gas, C0, N };
}

function fitCircleLS(xArr, yArr) {
  // Algebraic Kasa + Gauss-Newton refinement for circle (x - xc)^2 + (y - yc)^2 = R^2
  const n = xArr.length;
  if (n < 3) return { xc: 5.5, yc: -1.0, R: 2.2, eps0: 7.7, epsInf: 3.3, deltaEps: 4.4, beta: 0.7 };
  // Initial algebraic fit: x^2 + y^2 = 2*xc*x + 2*yc*y + (R^2 - xc^2 - yc^2)
  let Sx=0, Sy=0, Sxx=0, Syy=0, Sxy=0, Sz=0, Sxz=0, Syz=0;
  for (let i=0; i<n; i++) {
    const x = xArr[i], y = yArr[i], z = x*x + y*y;
    Sx += x; Sy += y; Sxx += x*x; Syy += y*y; Sxy += x*y;
    Sz += z; Sxz += x*z; Syz += y*z;
  }
  // Solve 3x3 linear system A * [2xc, 2yc, c]^T = b
  const M = [
    [Sxx, Sxy, Sx, Sxz],
    [Sxy, Syy, Sy, Syz],
    [Sx,  Sy,  n,  Sz]
  ];
  for (let i=0; i<3; i++) {
    let piv = M[i][i];
    if (Math.abs(piv) < 1e-12) continue;
    for (let j=i; j<4; j++) M[i][j] /= piv;
    for (let k=0; k<3; k++) {
      if (k !== i) {
        const factor = M[k][i];
        for (let j=i; j<4; j++) M[k][j] -= factor * M[i][j];
      }
    }
  }
  let xc = M[0][3] / 2.0;
  let yc = M[1][3] / 2.0;
  let R = Math.sqrt(Math.max(0.01, M[2][3] + xc*xc + yc*yc));

  // Gauss-Newton refinement on geometric distance
  for (let iter=0; iter<25; iter++) {
    let j00=0, j01=0, j02=0, j11=0, j12=0, j22=0;
    let b0=0, b1=0, b2=0;
    for (let i=0; i<n; i++) {
      const dx = xc - xArr[i], dy = yc - yArr[i];
      const dist = Math.sqrt(dx*dx + dy*dy) || 1e-9;
      const r_i = dist - R;
      const g0 = dx / dist, g1 = dy / dist, g2 = -1.0;
      j00 += g0*g0; j01 += g0*g1; j02 += g0*g2;
      j11 += g1*g1; j12 += g1*g2; j22 += g2*g2;
      b0 -= g0*r_i; b1 -= g1*r_i; b2 -= g2*r_i;
    }
    const G = [
      [j00, j01, j02, b0],
      [j01, j11, j12, b1],
      [j02, j12, j22, b2]
    ];
    for (let i=0; i<3; i++) {
      let piv = G[i][i];
      if (Math.abs(piv) < 1e-12) continue;
      for (let j=i; j<4; j++) G[i][j] /= piv;
      for (let k=0; k<3; k++) {
        if (k !== i) {
          const f = G[k][i];
          for (let j=i; j<4; j++) G[k][j] -= f * G[i][j];
        }
      }
    }
    xc += G[0][3]; yc += G[1][3]; R += G[2][3];
  }
  const hc = Math.sqrt(Math.max(0, R*R - yc*yc));
  const eps0 = xc + hc;
  const epsInf = xc - hc;
  const deltaEps = eps0 - epsInf;
  const theta = Math.atan2(-yc, hc);
  const beta = 1.0 - theta / (Math.PI / 2.0);
  return { xc, yc, R, eps0, epsInf, deltaEps, beta };
}

