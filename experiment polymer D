  .kpi-card .k-title { font-size: 0.78rem; color: var(--muted); font-weight: 600; }
  .kpi-card .k-val { font-size: 1.2rem; font-weight: 800; color: var(--navy); margin-top: 2px; }
  .kpi-card .k-sub { font-size: 0.76rem; color: var(--muted); }
  .formula-box {
    background: #f8fafc; border-left: 4px solid var(--teal);
    padding: 10px 14px; margin: 8px 0; font-size: 0.86rem; border-radius: 4px;
  }
  code {
    background: #e2e8f0; padding: 2px 6px; border-radius: 4px;
    font-family: ui-monospace, SFMono-Regular, Consolas, monospace; font-size: 0.84rem;
